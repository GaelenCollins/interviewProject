# ── Server only (Express / Render / Railway). Never use a VITE_ prefix. ──
ANTHROPIC_API_KEY=sk-ant-...

# Model routing — Haiku for cheap tasks, Sonnet for deep check/chat
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_SONNET_MODEL=claude-sonnet-4-5

# Local API port (default 3001). Render/Railway usually set PORT for you.
API_PORT=3001

# Optional: comma-separated frontend origins allowed by CORS
# (*.netlify.app is already allowed). Example:
# FRONTEND_URL=https://your-site.netlify.app
# CORS_ORIGINS=https://your-site.netlify.app,https://custom-domain.com
FRONTEND_URL=
CORS_ORIGINS=

# ── Client (Vite / Netlify). Safe to expose in the browser. ──
# Local default (when unset): http://localhost:3001
# Netlify / production — set to your Render or Railway API origin:
VITE_API_BASE_URL=https://your-backend.onrender.com
