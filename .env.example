# ── Server only (Express / Render). Never use a VITE_ prefix. ──
ANTHROPIC_API_KEY=sk-ant-...

CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_SONNET_MODEL=claude-sonnet-4-5

# Local Express port (Vite proxies /api → this port during `pnpm dev`)
API_PORT=3001

# Optional CORS extras on the API host (*.netlify.app already allowed)
FRONTEND_URL=
CORS_ORIGINS=

# ── Client (Vite / Netlify) ──
# Leave UNSET for local `pnpm dev` — browser calls /api and Vite proxies to :3001.
# On Netlify only, set to your Render origin (no trailing slash):
# VITE_API_BASE_URL=https://interviewprojectapi.onrender.com
VITE_API_BASE_URL=
